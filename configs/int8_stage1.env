# Source in every worker's environment before starting vLLM.
sharedkv_stage_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export SHAREDKV_INT8_MODE=int8
export SHAREDKV_SCALES="${SHAREDKV_SCALES:-$sharedkv_stage_root/npu_sparse_attn_sharedkv_int8/data/scales_v1.pt}"
export SHAREDKV_HOST_QUEUE=1
export SHAREDKV_COMPACT_PAGES=1
export SHAREDKV_C8_DECODE=1
unset sharedkv_stage_root
