+"""Preserve metadata values and reject unsafe local graph disagreement."""
+
+import importlib.util
+from pathlib import Path
+from types import SimpleNamespace as NS
+from unittest.mock import Mock
+
+import pytest
+import torch
+
+ROOT = Path(__file__).resolve().parents[4]
+SPEC = importlib.util.spec_from_file_location(
+    "compact_dp_metadata_contract", ROOT / "vllm_ascend/worker/compact_dp_metadata.py"
+)
+relay = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(relay)
+
+
+def fixture(monkeypatch, dp_rank=0, tp_rank=0, enabled=True):
+    runner = NS(
+        dp_rank=dp_rank,
+        vllm_config=NS(
+            kv_transfer_config=NS(
+                kv_connector="AscendStoreConnector",
+                kv_connector_extra_config={"backend": "memcache", "cache_compatibility_manifest": "frozen.json"}
+                if enabled
+                else {},
+            ),
+            parallel_config=NS(
+                tensor_parallel_size=16,
+                data_parallel_size=2,
+                data_parallel_size_local=1,
+                pipeline_parallel_size=1,
+                prefill_context_parallel_size=1,
+                decode_context_parallel_size=1,
+            ),
+        ),
+    )
+    group = NS(cpu_group=object(), world_size=2)
+    tp = NS(
+        rank_in_group=tp_rank,
+        world_size=16,
+        mq_broadcaster=NS(handle=NS(local_reader_ranks=list(range(1, 16)), remote_subscribe_addr=None)),
+        broadcast_object=Mock(side_effect=lambda payload, src: payload),
+    )
+    monkeypatch.setattr(relay, "get_tp_group", lambda: tp)
+    monkeypatch.setattr(relay, "get_dp_group", lambda: group)
+    reduction = Mock()
+    monkeypatch.setattr(relay.dist, "all_reduce", reduction)
+    return runner, tp, group, reduction
+
+
+@pytest.mark.parametrize("dp_rank", [0, 1])
+@pytest.mark.parametrize("tp_rank", [0, 1, 15])
+@pytest.mark.parametrize("tokens,modes", [([0, 0], [0, 0]), ([0, 6], [0, 2]), ([6, 12], [2, 2]), ([4096, 48], [0, 1])])
+def test_identical_to_all_dp_sum_for_dummy_prefill_decode(monkeypatch, dp_rank, tp_rank, tokens, modes):
+    runner, tp, group, reduction = fixture(monkeypatch, dp_rank, tp_rank)
+    expected = torch.tensor([tokens, modes], dtype=torch.int32)
+    # Multiple steps prove that old broadcast data cannot be silently reused.
+    for sequence in range(3):
+        packed = torch.zeros((2, 2), dtype=torch.int32)
+        packed[:, dp_rank] = expected[:, dp_rank]
+        local = expected[:, dp_rank].tolist()
+        if tp_rank == 0:
+            reduction.side_effect = lambda tensor, group: tensor.copy_(expected)
+        else:
+            tp.broadcast_object.side_effect = None
+            tp.broadcast_object.return_value = (relay._TAG, sequence, local, expected.tolist())
+        relay.reduce_dp_metadata(runner, packed)
+        assert torch.equal(packed, expected)
+        assert runner._compact_dp_metadata_sequence == sequence + 1
+    assert reduction.call_count == (3 if tp_rank == 0 else 0)
+    if tp_rank == 0:
+        assert all(call.kwargs["group"] is group.cpu_group for call in reduction.call_args_list)
+
+
+@pytest.mark.parametrize("transfer", ["legacy", "none"])
+def test_noncompact_path_uses_original_collective(monkeypatch, transfer):
+    runner, tp, group, reduction = fixture(monkeypatch, enabled=False)
+    if transfer == "none":
+        runner.vllm_config.kv_transfer_config = None
+    packed = torch.zeros((2, 2), dtype=torch.int32)
+    relay.reduce_dp_metadata(runner, packed)
+    reduction.assert_called_once_with(packed, group=group.cpu_group)
+    tp.broadcast_object.assert_not_called()
+
+
+@pytest.mark.parametrize(
+    "field,value",
+    [
+        ("tensor_parallel_size", 8),
+        ("data_parallel_size", 4),
+        ("data_parallel_size_local", 2),
+        ("pipeline_parallel_size", 2),
+        ("prefill_context_parallel_size", 2),
+        ("decode_context_parallel_size", 2),
+    ],
+)
+def test_unsupported_parallelism_rejected_before_collective(monkeypatch, field, value):
+    runner, tp, _, reduction = fixture(monkeypatch)
+    setattr(runner.vllm_config.parallel_config, field, value)
+    with pytest.raises(ValueError, match="requires local"):
+        relay.reduce_dp_metadata(runner, torch.zeros((2, 2), dtype=torch.int32))
+    reduction.assert_not_called()
+    tp.broadcast_object.assert_not_called()
+
+
+@pytest.mark.parametrize("missing", ["queue", "local_reader", "remote_reader"])
+def test_nonlocal_tp_topology_rejected(monkeypatch, missing):
+    runner, tp, _, reduction = fixture(monkeypatch)
+    if missing == "queue":
+        tp.mq_broadcaster = None
+    elif missing == "local_reader":
+        tp.mq_broadcaster.handle.local_reader_ranks.pop()
+    else:
+        tp.mq_broadcaster.handle.remote_subscribe_addr = "tcp://remote"
+    with pytest.raises(ValueError, match="shared-memory"):
+        relay.reduce_dp_metadata(runner, torch.zeros((2, 2), dtype=torch.int32))
+    reduction.assert_not_called()
+
+
+@pytest.mark.parametrize(
+    "payload",
+    [
+        None,
+        (relay._TAG, 1, [6, 2], [[6, 12], [2, 2]]),
+        (relay._TAG, 0, [6, 0], [[6, 12], [0, 2]]),
+        (relay._TAG, 0, [7, 2], [[7, 12], [2, 2]]),
+        ("wrong", 0, [6, 2], [[6, 12], [2, 2]]),
+    ],
+)
+def test_stale_or_rank_divergent_input_rejected_without_writing(monkeypatch, payload):
+    runner, tp, _, reduction = fixture(monkeypatch, tp_rank=15)
+    packed = torch.tensor([[6, 0], [2, 0]], dtype=torch.int32)
+    before = packed.clone()
+    tp.broadcast_object.side_effect = None
+    tp.broadcast_object.return_value = payload
+    with pytest.raises(RuntimeError, match="mismatch"):
+        relay.reduce_dp_metadata(runner, packed)
+    assert torch.equal(packed, before)
+    assert runner._compact_dp_metadata_sequence == 0
+    reduction.assert_not_called()
+
+
+@pytest.mark.parametrize(
+    "values", [[], [[6], [2]], [[6, -1], [2, 2]], [[6, 1 << 40], [2, 2]], [[6, 12.0], [2, 2]], [[7, 12], [2, 2]]]
+)
+def test_malformed_result_rejected_without_writing(monkeypatch, values):
+    runner, tp, _, _ = fixture(monkeypatch, tp_rank=1)
+    packed = torch.tensor([[6, 0], [2, 0]], dtype=torch.int32)
+    before = packed.clone()
+    tp.broadcast_object.side_effect = None
+    tp.broadcast_object.return_value = (relay._TAG, 0, [6, 2], values)
+    with pytest.raises(RuntimeError, match="Malformed"):
+        relay.reduce_dp_metadata(runner, packed)
+    assert torch.equal(packed, before)
+
+
+def test_leader_transport_failure_never_broadcasts_success(monkeypatch):
+    runner, tp, _, reduction = fixture(monkeypatch)
+    reduction.side_effect = RuntimeError("transport failure")
+    with pytest.raises(RuntimeError, match="transport failure"):
+        relay.reduce_dp_metadata(runner, torch.zeros((2, 2), dtype=torch.int32))
+    tp.broadcast_object.assert_not_called()
+    assert runner._compact_dp_metadata_sequence == 0
