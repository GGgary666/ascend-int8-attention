+"""Wire compatibility and protection boundaries for registered compact plans."""
+import random
+
+import pytest
+
+import tests.ut.distributed.ascend_store._mock_deps  # noqa: F401
+from vllm_ascend.distributed.kv_transfer.kv_pool.ascend_store.metadata import (
+    ChunkedTokenDatabase,
+    KeyMetadata,
+)
+
+
+def database(namespace='a' * 64, blocks=8, ranges=((1000, 2024),),
+             bases=(1000, 1008, 1032), lengths=(8, 8, 4), strides=(128, 128, 128)):
+    db = ChunkedTokenDatabase([KeyMetadata('model', 0, 0, 0, cache_namespace=namespace)], [16], None)
+    db.set_group_buffers({0: list(bases)}, {0: list(lengths)}, {0: list(strides)},
+                         registered_regions=ranges, num_blocks=blocks,
+                         group_layer_cache_entry_offsets={0: [0, 2, 3]})
+    return db
+
+
+def wire(addresses, lengths):
+    return [offset for address, length in zip(addresses, lengths, strict=True)
+            for offset in range(address, address + length)]
+
+
+@pytest.mark.parametrize('block', [0, 3, 7])
+def test_full_pages_preserve_order_and_gaps(block):
+    db = database()
+    original = [1000 + 128 * block, 1008 + 128 * block, 1032 + 128 * block]
+    addresses, sizes, actual = db.prepare_value(0, 16, [block])
+    assert actual == block and sizes == [16, 4]
+    assert wire(addresses, sizes) == wire(original, [8, 8, 4])
+    assert db.group_block_len == {0: [8, 8, 4]}
+    assert db.group_layer_cache_entry_offsets == {0: [0, 2, 3]}
+    # Backend mutation of returned vectors cannot corrupt the next transfer.
+    addresses.clear()
+    sizes.clear()
+    assert db.prepare_value(0, 16, [block])[1] == [16, 4]
+
+
+@pytest.mark.parametrize('count', [1, 7, 15])
+def test_partial_page_preserves_per_component_truncation(count):
+    db = database(lengths=(7, 9, 4), bases=(1000, 1007, 1032))
+    assert db.prepare_value(0, count, [2]) == (
+        [1256, 1263, 1288], [int(7 / 16 * count), int(9 / 16 * count), int(4 / 16 * count)], 2)
+
+
+@pytest.mark.parametrize('kwargs', [
+    {'namespace': None}, {'ranges': None}, {'blocks': None},
+    {'ranges': ((1000, 1904),)},  # last physical page exceeds this registration
+    {'ranges': ((1000, 1008), (1008, 2024))},  # adjacency across allocations
+    {'strides': (128, 129, 128)},
+])
+def test_missing_proof_does_not_merge(kwargs):
+    assert database(**kwargs).prepare_value(0, 16, [0])[1] == [8, 8, 4]
+
+
+def test_registration_replacement_discards_old_addresses():
+    db = database()
+    db.set_group_buffers({0: [4000, 4010]}, {0: [10, 2]}, {0: [64, 64]},
+                         registered_regions=[(4000, 4524)], num_blocks=8)
+    assert db.prepare_value(0, 16, [7]) == ([4448], [12], 7)
+    db.set_group_buffers({0: [6000]}, {0: [9]}, {0: [64]})
+    assert db.prepare_value(0, 16, [2]) == ([6128], [9], 2)
+    assert db._full_block_transfer_plans == {}
+
+
+def test_role_and_unaligned_ranges_keep_legacy_path():
+    db = database()
+    assert db.prepare_value(0, 16, [0], cache_role='state') == ([], [], 0)
+    assert db.prepare_value(1, 17, [0])[1] == [8, 8, 4]
+    assert db.prepare_value(32, 48, [0]) == ([], [], 0)
+
+
+def test_groups_are_not_merged():
+    db = ChunkedTokenDatabase([KeyMetadata('model', 0, 0, 0, cache_namespace='a' * 64),
+                               KeyMetadata('model', 0, 0, 0, 1, cache_namespace='a' * 64)], [16, 32], None)
+    db.set_group_buffers({0: [1000], 1: [1008]}, {0: [8], 1: [8]}, {0: [64], 1: [64]},
+                         registered_regions=[(1000, 1512)], num_blocks=8)
+    assert db.prepare_value(0, 16, [1], 0) == ([1064], [8], 1)
+    assert db.prepare_value(0, 32, [1], 1) == ([1072], [8], 1)
+
+
+def test_randomized_wire_and_padding_preservation():
+    rng = random.Random(642081)
+    for _ in range(500):
+        count = rng.randrange(1, 18)
+        lengths = [rng.randrange(1, 33) for _ in range(count)]
+        bases = [1000]
+        for size in lengths[:-1]:
+            bases.append(bases[-1] + size + rng.choice([0, 0, 0, 2, 11]))
+        stride = bases[-1] + lengths[-1] - 1000 + 37
+        blocks = rng.randrange(2, 12)
+        db = database(blocks=blocks, ranges=[(1000, 1000 + blocks * stride)],
+                      bases=bases, lengths=lengths, strides=[stride] * count)
+        for block in {0, blocks - 1, rng.randrange(blocks)}:
+            original = [base + block * stride for base in bases]
+            actual, sizes, _ = db.prepare_value(0, 16, [block])
+            expected_wire = wire(original, lengths)
+            assert wire(actual, sizes) == expected_wire
+            # A simulated GET must leave every unrelated byte untouched.
+            backing = bytearray([0xA5] * (blocks * stride))
+            for offset in wire(actual, sizes):
+                backing[offset - 1000] = 0x5A
+            assert {i + 1000 for i, byte in enumerate(backing) if byte != 0xA5} == set(expected_wire)
