+def upstream_future():
+    """Use the actual lazy mp FutureWrapper; ordinary Future hid a deadlock."""
+    package = importlib.util.find_spec("vllm")
+    if package is None:
+        pytest.skip("Pinned vLLM source not installed")
+    path = Path(package.origin).parent / "v1/executor/multiproc_executor.py"
