+"""Content identity and byte contracts for the compact shared-KV protocol.
+
+This module is shared by scheduler, worker and deployment tools. It deliberately
+has no device imports: identity must not depend on an allocator or a DP rank.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+from collections.abc import Mapping
+from dataclasses import fields, is_dataclass
+from pathlib import Path
+from typing import Any
+
+SHAREDKV_CACHE_PROTOCOL = "sharedkv-c8-memcache-v1"
+SHAREDKV_COMPUTE_REVISION = "v65-p101-stage1"
+SHAREDKV_ENCODING = "sharedkv-c8-v1"
+PROTOCOL_SOURCE_FILES = (
+    "cache_compatibility.py", "ascend_store_connector.py", "pool_scheduler.py",
+    "pool_worker.py", "metadata.py", "kv_transfer.py", "metrics.py", "backend/memcache_backend.py",
+    "../../../../patch/platform/patch_compact_load_progress.py",
+    "../../../../worker/compact_dp_metadata.py",
+    "../../../../worker/model_runner_v1.py",
+    "../../../../compilation/task_queue.py",
+)
+
+
+def patch_source_hashes() -> dict[str, str]:
+    root = Path(__file__).parent
+    return {name: content_digest(root / name) for name in PROTOCOL_SOURCE_FILES}
+
+
+def validate_memcache_config(path: str | Path) -> None:
+    settings = {}
+    with open(path, encoding="utf-8") as stream:
+        for line in stream:
+            key, separator, value = line.partition("=")
+            if separator:
+                settings[key.strip()] = value.strip()
+    required = {"ock.mmc.local_service.protocol": "device_sdma",
+                "ock.mmc.local_service.dram.size": "0GB",
+                "ock.mmc.local_service.storage.enabled": "false"}
+    for key, value in required.items():
+        if settings.get(key) != value:
+            raise ValueError(f"Compact C8 model clients require {key}={value}")
+
+
+def canonical_digest(value: Any) -> str:
+    return hashlib.sha256(
+        json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
+    ).hexdigest()
+
+
+def content_digest(path: str | Path) -> str:
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+        for data in iter(lambda: stream.read(8 * 1024 * 1024), b""):
+            digest.update(data)
+    return digest.hexdigest()
+
+
+def load_manifest(path: str | Path) -> dict[str, Any]:
+    with open(path, encoding="utf-8") as stream:
+        manifest = json.load(stream)
+    expected = {
+        "format_version": 1,
+        "protocol": SHAREDKV_CACHE_PROTOCOL,
+        "encoding": SHAREDKV_ENCODING,
+        "compute_revision": SHAREDKV_COMPUTE_REVISION,
+        "layout": "compact-c8-v1",
+    }
+    for name, value in expected.items():
+        if manifest.get(name) != value:
+            raise ValueError(f"Incompatible cache manifest {name}: expected {value!r}")
+    for name in ("model_digest", "scales_digest"):
+        value = manifest.get(name)
+        if not isinstance(value, str) or len(value) != 64 or any(c not in "0123456789abcdef" for c in value):
+            raise ValueError(f"Invalid cache manifest {name}")
+    identity = {name: manifest[name] for name in (*expected, "model_digest", "scales_digest")}
+    if manifest.get("identity_digest") != canonical_digest(identity):
+        raise ValueError("Cache manifest identity checksum mismatch")
+    # Deployment freezes the complete paired Python patch. Checking only a
+    # version constant could accidentally accept a partially applied patch.
+    if manifest.get("patch_sources_sha256") != patch_source_hashes():
+        raise ValueError("Paired vLLM-Ascend patch source checksum mismatch")
+    return manifest
+
+
+def validate_configuration(config: Any, manifest: Mapping[str, Any]) -> None:
+    """Fail closed for combinations outside the validated first release."""
+    transfer = config.kv_transfer_config
+    extra = transfer.kv_connector_extra_config
+    parallel = config.parallel_config
+    requirements = {
+        "data_parallel_size": 2, "data_parallel_size_local": 1,
+        "tensor_parallel_size": 16, "pipeline_parallel_size": 1,
+        "prefill_context_parallel_size": 1, "decode_context_parallel_size": 1,
+    }
+    for name, expected in requirements.items():
+        if getattr(parallel, name, None) != expected:
+            raise ValueError(f"{SHAREDKV_CACHE_PROTOCOL} requires {name}={expected}")
+    if not parallel.enable_expert_parallel:
+        raise ValueError("Compact C8 MemCache requires expert parallelism")
+    if (transfer.kv_connector != "AscendStoreConnector" or transfer.kv_role != "kv_both"
+            or extra.get("backend") != "memcache" or extra.get("use_layerwise", False)
+            or extra.get("load_async", False) or extra.get("consumer_is_to_load", False)
+            or extra.get("consumer_is_to_put", False)):
+        raise ValueError("Compact C8 requires AscendStoreConnector/kv_both/memcache, synchronous non-layerwise I/O")
+    if transfer.kv_load_failure_policy != "fail":
+        raise ValueError("Compact C8 requires kv_load_failure_policy=fail")
+    speculative = config.speculative_config
+    if (speculative is None or speculative.method != "dspark"
+            or speculative.num_speculative_tokens != 5):
+        raise ValueError("Compact C8 MemCache currently requires DSpark5")
+    # Only small metadata files are checked here. Weight content is hashed and
+    # frozen once by the deployment preparation tool, on both nodes.
+    model_root = Path(config.model_config.model)
+    for relative, expected_digest in manifest.get("metadata_files", {}).items():
+        relative_path = Path(relative)
+        if relative_path.is_absolute() or ".." in relative_path.parts:
+            raise ValueError("Manifest model paths must be relative")
+        if content_digest(model_root / relative_path) != expected_digest:
+            raise ValueError(f"Model metadata changed: {relative}")
+
+
+def _semantic_value(value: Any) -> Any:
+    if is_dataclass(value):
+        # Allocator padding/strides and physical capacity are not wire identity.
+        excluded = {"num_blocks", "page_size_padded", "alignment", "indexes_kv_by_block_stride"}
+        return {"type": type(value).__name__, **{
+            field.name: _semantic_value(getattr(value, field.name))
+            for field in fields(value) if field.name not in excluded
+        }}
+    if isinstance(value, Mapping):
+        return {str(key): _semantic_value(item) for key, item in sorted(value.items())}
+    if isinstance(value, (list, tuple)):
+        return [_semantic_value(item) for item in value]
+    if value is None or isinstance(value, (str, bool, int, float)):
+        return value
+    # torch.dtype (no torch dependency here).
+    if type(value).__name__ == "dtype":
+        return str(value)
+    raise TypeError(f"Unsupported semantic cache field: {type(value).__name__}")
+
+
+def cache_schema(kv_cache_config: Any) -> list[dict[str, Any]]:
+    groups = []
+    for group_id, group in enumerate(kv_cache_config.kv_cache_groups):
+        specs = getattr(group.kv_cache_spec, "kv_cache_specs", None)
+        components = [{"layer": name, "spec": _semantic_value(specs[name] if specs else group.kv_cache_spec)}
+                      for name in sorted(group.layer_names)]
+        groups.append({"group": group_id, "components": components})
+    return groups
+
+
+def cache_namespace(config: Any, kv_cache_config: Any) -> str | None:
+    path = config.kv_transfer_config.kv_connector_extra_config.get("cache_compatibility_manifest")
+    if path is None:
+        return None
+    manifest = load_manifest(path)
+    validate_configuration(config, manifest)
+    parallel = config.parallel_config
+    return canonical_digest({
+        "identity": manifest["identity_digest"], "groups": cache_schema(kv_cache_config),
+        "sharding": {name: getattr(parallel, name) for name in (
+            "tensor_parallel_size", "pipeline_parallel_size", "prefill_context_parallel_size",
+            "decode_context_parallel_size")},
+    })
+
+
+def object_key(metadata: Any, chunk_hash: str, layer_id: int | None = None) -> str:
+    digest = canonical_digest({
+        "tp": metadata.head_or_tp_rank, "dcp": metadata.dcp_rank, "pp": metadata.pp_rank,
+        "group": metadata.kv_cache_group_id, "role": metadata.cache_role,
+        "family": metadata.cache_family, "token_hash": chunk_hash, "layer": layer_id,
+    })
+    return f"asc8v1:{metadata.cache_namespace}:{digest}"
+
+
+class ObjectKeyEncoder:
+    """Reuse fixed semantic fields while preserving the exact v1 key bytes.
+
+    Each database owns encoders for its finite group/rank descriptors. No
+    token hashes or per-request results are retained. The prefix hash is only
+    copied, never mutated after construction.
+    """
+
+    def __init__(self, metadata: Any, layer_id: int | None = None):
+        value = {
+            "tp": metadata.head_or_tp_rank,
+            "dcp": metadata.dcp_rank,
+            "pp": metadata.pp_rank,
+            "group": metadata.kv_cache_group_id,
+            "role": metadata.cache_role,
+            "family": metadata.cache_family,
+            "token_hash": None,
+            "layer": layer_id,
+        }
+        serialized = json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
+        before, self._after = serialized.split(b'"token_hash":null')
+        self._prefix = hashlib.sha256(before + b'"token_hash":')
+        self._namespace = f"asc8v1:{metadata.cache_namespace}:"
+
+    def encode(self, chunk_hash: str) -> str:
+        if isinstance(chunk_hash, str) and chunk_hash.isascii() and chunk_hash.isalnum():
+            encoded = b'"' + chunk_hash.encode() + b'"'
+        else:
+            encoded = json.dumps(chunk_hash, separators=(",", ":"), allow_nan=False).encode()
+        digest = self._prefix.copy()
+        digest.update(encoded)
+        digest.update(self._after)
+        return self._namespace + digest.hexdigest()
+
+
+def describe_block_view(cache: Any, num_blocks: int) -> tuple[int, int, int, int]:
+    """Return valid bytes, physical stride, spanned range and kernel scale.
+
+    A native scatter entry is contiguous. Reject layouts whose inner padding
+    cannot be expressed as that entry instead of copying unrelated bytes.
+    """
+    if num_blocks <= 0 or cache.shape[0] % num_blocks:
+        raise ValueError("Invalid compact block count")
+    scale = cache.shape[0] // num_blocks
+    if scale != 1 or not cache[0].is_contiguous():
+        raise ValueError("Compact transfer requires one contiguous component per logical page")
+    length = cache[0].numel() * cache.element_size()
+    stride = cache.stride(0) * cache.element_size()
+    region = (num_blocks - 1) * stride + length
+    storage = cache.untyped_storage()
+    if (length <= 0 or stride < length or cache.data_ptr() < storage.data_ptr()
+            or cache.data_ptr() + region > storage.data_ptr() + storage.nbytes()):
+        raise ValueError("Compact transfer exceeds backing allocation")
+    return length, stride, region, scale
+
+
+def key_info_matches(info: Any, expected_bytes: int) -> bool:
+    if info is None:
+        return False
+    try:
+        gvas = info.gva_list()
+        return int(info.size()) == expected_bytes and bool(gvas) and all(int(gva) > 0 for gva in gvas)
+    except (AttributeError, TypeError, ValueError):
+        return False
+
+
+def write_worker_audit(directory: str | Path, worker: Any) -> None:
+    """Record what every worker actually imported and registered."""
+    module_names = ("npu_sparse_attn_sharedkv_int8", "vllm_ascend", "vllm")
+    modules = {name: str(importlib.util.find_spec(name).origin) for name in module_names}
+    plugin_root = Path(modules["npu_sparse_attn_sharedkv_int8"]).parent
+    native = {path.name: content_digest(path) for path in (plugin_root / "_native").glob("*.so")}
+    components = []
+    for name, caches in worker.kv_caches.items():
+        for index, cache in enumerate(worker._as_cache_tuple(caches)):
+            length, stride, span, _ = describe_block_view(cache, worker.num_blocks)
+            components.append({"layer": name, "component": index, "dtype": str(cache.dtype),
+                               "shape": list(cache.shape[1:]), "bytes": length, "stride": stride,
+                               "base": cache.data_ptr(), "span": span,
+                               "storage": cache.untyped_storage().data_ptr()})
+    record = {"protocol": SHAREDKV_CACHE_PROTOCOL, "namespace": worker.cache_namespace,
+              "dp_rank": worker.vllm_config.parallel_config.data_parallel_rank,
+              "tp_rank": worker.tp_rank, "modules": modules, "native_sha256": native,
+              "num_blocks": worker.num_blocks, "components": components,
+              "protocol_source_sha256": content_digest(__file__),
+              "worker_source_sha256": content_digest(importlib.util.find_spec(type(worker).__module__).origin)}
+    directory = Path(directory)
+    directory.mkdir(parents=True, exist_ok=True)
+    target = directory / f"dp{record['dp_rank']}-tp{worker.tp_rank}.json"
+    target.write_text(json.dumps(record, indent=2) + "\n")
