--- /dev/null
+++ b/vllm_ascend/patch/platform/patch_compact_load_progress.py
@@ -0,0 +1,179 @@
+"""Progress synchronous C8 receive batches before the DP dummy fallback.
+
+The asynchronous engine queue normally spends two outer iterations submitting
+and collecting a zero-token receive. Each iteration triggers a full DP dummy
+model pass. The receive itself has no DP model collective with the mp executor,
+so its completion can be consumed before choosing this iteration's one forward.
+
+Keep the upstream scheduler/abort/output paths, WAITING_FOR_REMOTE_KVS, TP
+receive consensus and page ownership unchanged. This patch only advances the
+existing queue; it never promotes a request or calls attention directly.
+
+Upstream follow-up: expose a connector capability for synchronous, zero-token
+progress without consuming a DP model iteration, then remove this pinned patch.
+"""
+
+from __future__ import annotations
+
+import functools
+import hashlib
+from collections.abc import Callable
+from pathlib import Path
+from queue import Empty
+from typing import Any
+
+FIRST_WAVE_INPUT_WAIT_SECONDS = 0.005
+
+ENGINE_CORE_SHA256 = "268bf40534a853812867ae8e80040f190983cb364b41182b55969aace20c93f5"
+
+
+def _has_forward(batch_queue: Any) -> bool:
+    return any(output.total_num_scheduled_tokens > 0 for _, output, _ in batch_queue)
+
+
+def _pending_receives(scheduler: Any, pool: Any) -> set[str]:
+    # Include completed but not yet promoted receives (also covers queue size 1).
+    return set(pool._loading_req_ids) | scheduler.finished_recving_kv_req_ids
+
+
+def _await_zero_batch(engine: Any) -> bool:
+    """Admit input that arrived during the existing synchronous receive.
+
+    The queued zero-token batch keeps has_work() true, so the upstream input
+    method drains available messages without blocking. No new transfer thread
+    or model execution is started here. In particular, observing a completed
+    future does not publish its receive result to the scheduler yet. The mp
+    executor's FutureWrapper is lazy: result(), not done(), drives reception.
+    """
+    future, output, _ = engine.batch_queue[-1]
+    assert output.total_num_scheduled_tokens == 0
+    before = set(engine.scheduler.requests)
+    process_inputs = getattr(engine, "_process_input_queue", None)
+    if process_inputs is not None:
+        process_inputs()
+    with engine.log_error_detail(output):
+        future.result()
+    if process_inputs is not None:
+        process_inputs()
+    return bool(set(engine.scheduler.requests) - before)
+
+
+def _consume_zero_batch(engine: Any) -> None:
+    """Consume one FIFO result using the hash-pinned upstream completion path.
+
+    Unlike another schedule/execute step, this does not submit an empty worker
+    batch or schedule a forward ahead of an already submitted receive result.
+    The same abort, scheduler, output and post-step hooks retain ownership and
+    fail-policy handling. A completed future needs no background-I/O GIL yield.
+    """
+    future, output, exec_future = engine.batch_queue.pop()
+    assert output.total_num_scheduled_tokens == 0
+    with engine.capture_iteration_details(output) as details, engine.log_error_detail(output):
+        model_output = future.result()
+        if model_output is None:
+            exec_future.result()
+            raise RuntimeError("unexpected error")
+    engine._process_aborts_queue()
+    outputs = engine.scheduler.update_from_output(output, model_output)
+    engine._attach_iteration_details(outputs, details)
+    for item in outputs.items() if outputs else ():
+        engine.output_queue.put_nowait(item)
+    engine.post_step(False)
+
+
+def progress_step(engine: Any, original: Callable[[Any], bool]) -> bool:
+    scheduler = engine.scheduler
+    connector = getattr(scheduler, "connector", None)
+    pool = getattr(connector, "connector_scheduler", None)
+    batch_queue = engine.batch_queue
+    if pool is None or pool.requires_load_completion is not True or batch_queue is None or not engine.is_ec_consumer:
+        return original(engine)
+
+    # START_DP_WAVE can precede an already dispatched local request. Only
+    # the idle peer in the first wave waits briefly for its existing input
+    # queue. A real input ends the wait immediately; all message kinds keep
+    # their original handler. The upper bound is verified in per-case timing.
+    if (
+        getattr(engine, "engines_running", False)
+        and engine.step_counter == 0
+        and not engine.pending_pause
+        and not batch_queue
+        and not scheduler.has_requests()
+    ):
+        try:
+            message = engine.input_queue.get(timeout=FIRST_WAVE_INPUT_WAIT_SECONDS)
+        except Empty:
+            pass
+        else:
+            engine._handle_client_request(*message)
+        engine._process_input_queue()
+
+    # An already submitted forward must retain its normal outer-loop ordering,
+    # even if this call consumes its result and leaves an empty queue.
+    had_forward = _has_forward(batch_queue)
+    pending = _pending_receives(scheduler, pool)
+    executed = original(engine)
+    if executed or had_forward:
+        return executed
+    pending |= _pending_receives(scheduler, pool)
+
+    # Drain at most a queue's worth of zero-token outputs plus one promotion.
+    # Synchronous GET may block here, just as future.result() normally does.
+    # No polling thread, unbounded busy loop, or extra real forward is added.
+    for _ in range(engine.batch_queue_size + 1):
+        live = any(
+            request_id in scheduler.requests and not scheduler.requests[request_id].is_finished()
+            for request_id in pending
+        )
+        if not live or _has_forward(batch_queue):
+            break
+        if batch_queue:
+            if _await_zero_batch(engine):
+                # The earlier result is still queued. Let the original
+                # scheduler submit loads for newly arrived requests before
+                # promoting that earlier receive into a real prefill.
+                executed = original(engine)
+                if executed or _has_forward(batch_queue):
+                    return executed
+                pending |= _pending_receives(scheduler, pool)
+            for _ in range(engine.batch_queue_size):
+                if not batch_queue or _has_forward(batch_queue):
+                    break
+                _await_zero_batch(engine)
+                _consume_zero_batch(engine)
+            pending |= _pending_receives(scheduler, pool)
+            if not any(
+                request_id in scheduler.requests and not scheduler.requests[request_id].is_finished()
+                for request_id in pending
+            ):
+                break
+        executed = original(engine)
+        if executed:
+            return True
+        pending |= _pending_receives(scheduler, pool)
+    return False
+
+
+def install(config: Any) -> bool:
+    """Install only in the C8 scheduler process for the audited mp DP engine."""
+    if config.parallel_config.distributed_executor_backend != "mp":
+        return False
+    # Lazy: workers must not import/modify the scheduler engine during setup.
+    from vllm.v1.engine import core
+
+    if hashlib.sha256(Path(core.__file__).read_bytes()).hexdigest() != ENGINE_CORE_SHA256:
+        raise ValueError("Compact C8 load progress requires the validated vLLM engine core source")
+    engine_class = core.DPEngineCoreProc
+    if engine_class.__module__ != core.__name__:
+        raise ValueError("Compact C8 load progress requires the standard DP engine")
+    original = engine_class._process_engine_step
+    if getattr(original, "_compact_load_progress", False):
+        return True
+
+    @functools.wraps(original)
+    def process_engine_step(engine: Any) -> bool:
+        return progress_step(engine, original)
+
+    process_engine_step._compact_load_progress = True
+    engine_class._process_engine_step = process_engine_step
+    return True
