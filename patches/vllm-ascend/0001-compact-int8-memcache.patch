+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 Huawei Technologies Co., Ltd. All Rights Reserved.
+"""Queue level transition for the single-threaded startup capture phase."""
+
+from contextlib import contextmanager
+
+
+@contextmanager
+def startup_graph_task_queue(npu):
+    """Capture at level 1, then restore the requested eager/replay level.
+
+    Torch NPU rejects level 2 during graph capture. Its public setter drains
+    pending operations, so this scope belongs around the entire startup
+    capture phase, with no concurrent submissions or active serving requests.
+    Never use it per forward or while capturing an existing graph.
+    """
+    mode = npu.get_task_queue_enable()
+    if mode != 2:
+        yield
+        return
+    if npu.is_current_stream_capturing():
+        raise RuntimeError("Task queue level cannot change during graph capture")
+    npu.set_task_queue_enable(1)
+    try:
+        yield
+    finally:
+        npu.set_task_queue_enable(mode)
