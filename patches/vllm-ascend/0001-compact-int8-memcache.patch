new file mode 100644
--- /dev/null
+++ b/vllm_ascend/worker/compact_dp_metadata.py
@@ -0,0 +1,102 @@
+"""Relay identical TP metadata through one DP representative per host.
+
+The compact protocol admits two local TP16 groups with no context/pipeline
+parallelism. All TP workers receive the same scheduler input and choose the
+same graph mode. Exchange that input between the two TP leaders, then use the
+existing TP shared-memory broadcaster. Preserve the original SUM reduction,
+padding decisions and graph-mode minimum. This is unrelated to KV receive
+consensus: every TP worker still participates in that separate failure barrier.
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Any
+
+import torch
+import torch.distributed as dist
+from vllm.distributed.parallel_state import get_dp_group, get_tp_group
+
+_TAG = "sharedkv-dp-metadata-v1"
+
+
+def _enabled(runner: Any) -> bool:
+    selected = getattr(runner, "_compact_dp_metadata_relay", None)
+    if selected is not None:
+        return selected
+    config = runner.vllm_config
+    transfer = config.kv_transfer_config
+    extra = transfer.kv_connector_extra_config if transfer is not None else {}
+    selected = bool(extra.get("cache_compatibility_manifest"))
+    if selected:
+        parallel = config.parallel_config
+        required = {
+            "tensor_parallel_size": 16,
+            "data_parallel_size": 2,
+            "data_parallel_size_local": 1,
+            "pipeline_parallel_size": 1,
+            "prefill_context_parallel_size": 1,
+            "decode_context_parallel_size": 1,
+        }
+        if any(getattr(parallel, name, None) != value for name, value in required.items()):
+            raise ValueError("Compact DP metadata relay requires local TP16 / DP2 / PP1 / CP1")
+        if transfer.kv_connector != "AscendStoreConnector" or extra.get("backend") != "memcache":
+            raise ValueError("Compact DP metadata relay requires AscendStore MemCache")
+        tp, dp = get_tp_group(), get_dp_group()
+        queue = tp.mq_broadcaster
+        if (
+            tp.world_size != 16
+            or dp.world_size != 2
+            or queue is None
+            or queue.handle.local_reader_ranks != list(range(1, 16))
+            or queue.handle.remote_subscribe_addr is not None
+            or runner.dp_rank not in (0, 1)
+        ):
+            raise ValueError("Compact DP metadata relay requires all TP workers on one shared-memory host")
+        logging.getLogger(__name__).info(
+            "Compact DP metadata relay enabled: TP rank=%d DP rank=%d", tp.rank_in_group, runner.dp_rank
+        )
+    runner._compact_dp_metadata_relay = selected
+    runner._compact_dp_metadata_sequence = 0
+    return selected
+
+
+def reduce_dp_metadata(runner: Any, packed: torch.Tensor) -> None:
+    """Update the caller's ordinary CPU int32 metadata tensor in place."""
+    if not _enabled(runner):
+        dist.all_reduce(packed, group=get_dp_group().cpu_group)
+        return
+    if packed.device.type != "cpu" or packed.dtype != torch.int32 or tuple(packed.shape) != (2, 2):
+        raise ValueError("Compact DP metadata tensor must be CPU int32[2,2]")
+    tp = get_tp_group()
+    sequence = runner._compact_dp_metadata_sequence
+    local = packed[:, runner.dp_rank].tolist()
+    if tp.rank_in_group == 0:
+        # Same two-rank reduction and same zero-filled columns as upstream.
+        dist.all_reduce(packed, group=get_dp_group().cpu_group)
+        payload = (_TAG, sequence, local, packed.tolist())
+    else:
+        payload = None
+    payload = tp.broadcast_object(payload, src=0)
+    if (
+        not isinstance(payload, tuple)
+        or len(payload) != 4
+        or payload[0] != _TAG
+        or payload[1] != sequence
+        or payload[2] != local
+    ):
+        # Reject rank-dependent graph choices or stale messages before forward.
+        # Worker failure is propagated by the existing executor watchdog.
+        raise RuntimeError("Compact DP metadata sequence or local TP input mismatch")
+    values = payload[3]
+    if (
+        not isinstance(values, list)
+        or len(values) != 2
+        or any(not isinstance(row, list) or len(row) != 2 for row in values)
+        or any(type(value) is not int or not 0 <= value <= 2147483647 for row in values for value in row)
+        or [values[0][runner.dp_rank], values[1][runner.dp_rank]] != local
+    ):
+        raise RuntimeError("Malformed compact DP metadata result")
+    if tp.rank_in_group != 0:
+        packed.copy_(torch.tensor(values, dtype=torch.int32, device="cpu"))
+    runner._compact_dp_metadata_sequence = sequence + 1
