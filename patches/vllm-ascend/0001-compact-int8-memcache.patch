+    scheduler.has_requests = lambda: bool(scheduler.requests)
+
+    def schedule(_):
+        tokens, receive = 0, False
+        if not state["scheduled"]:
+            state["scheduled"] = True
+            pool._loading_req_ids.add("r")
+            receive = True
+        elif state["ready"]:
+            tokens = 32
+        return NS(total_num_scheduled_tokens=tokens, receive=receive, pending_structured_output_tokens=False)
+
+    scheduler.schedule = schedule
+
+    def update(output, result):
+        state["updates"].append(result)
+        if output.receive:
+            # In production this result is available only after checked GET +
+            # TP consensus. The normal scheduler, not the patch, promotes it.
+            pool._loading_req_ids.clear()
+            if terminal == "success":
+                scheduler.finished_recving_kv_req_ids.add("r")
+                state["ready"] = True
+            else:
