+"""CPU contracts for persistent compact KV objects and receive barriers."""
+
+import json
+from dataclasses import dataclass, replace
+from types import SimpleNamespace as NS
+from unittest.mock import MagicMock, patch
+
+import pytest
+import torch
+
+import tests.ut.distributed.ascend_store._mock_deps  # noqa: F401
+from vllm_ascend.distributed.kv_transfer.kv_pool.ascend_store import cache_compatibility as contract
+from vllm_ascend.distributed.kv_transfer.kv_pool.ascend_store.backend.memcache_backend import MemcacheBackend
+from vllm_ascend.distributed.kv_transfer.kv_pool.ascend_store.metadata import ChunkedTokenDatabase, KeyMetadata, PoolKey
+from vllm_ascend.distributed.kv_transfer.kv_pool.ascend_store.pool_worker import KVPoolWorker
+
+
+@dataclass
+class Spec:
+    block_size: int = 32
+    dtype: object = torch.int8
+    head_size: int = 512
+    num_kv_heads: int = 1
+    page_size_padded: int | None = None
+
+
+def configuration(tmp_path):
+    identity = dict(format_version=1, protocol=contract.SHAREDKV_CACHE_PROTOCOL,
+                    encoding=contract.SHAREDKV_ENCODING, compute_revision=contract.SHAREDKV_COMPUTE_REVISION,
+                    layout="compact-c8-v1", model_digest="a" * 64, scales_digest="b" * 64)
+    manifest = {**identity, "identity_digest": contract.canonical_digest(identity),
+                "patch_sources_sha256": contract.patch_source_hashes()}
+    path = tmp_path / "manifest.json"
+    path.write_text(json.dumps(manifest))
+    config = NS(kv_transfer_config=NS(kv_connector="AscendStoreConnector", kv_role="kv_both",
+                kv_load_failure_policy="fail", kv_connector_extra_config={"backend": "memcache",
+                "cache_compatibility_manifest": str(path)}),
+                parallel_config=NS(data_parallel_size=2, data_parallel_size_local=1,
+                tensor_parallel_size=16, pipeline_parallel_size=1, prefill_context_parallel_size=1,
+                decode_context_parallel_size=1, enable_expert_parallel=True, data_parallel_rank=0),
+                model_config=NS(model=str(tmp_path)), speculative_config=NS(method="dspark", num_speculative_tokens=5))
+    cache = NS(num_blocks=5, kv_cache_tensors=[NS(offset=512, block_stride=123456)],
+               kv_cache_groups=[NS(layer_names=["layers.0.kv"], kv_cache_spec=Spec())])
+    return config, cache, manifest, path
+
+
+def test_namespace_excludes_physical_capacity_dp_and_paths(tmp_path):
+    config, cache, _, path = configuration(tmp_path)
+    expected = contract.cache_namespace(config, cache)
+    config.parallel_config.data_parallel_rank = 1
+    cache.num_blocks = 200
+    cache.kv_cache_tensors[0].offset = 1024
+    cache.kv_cache_tensors[0].block_stride = 90000
+    other = tmp_path / "identical-copy.json"
+    other.write_bytes(path.read_bytes())
+    config.kv_transfer_config.kv_connector_extra_config["cache_compatibility_manifest"] = str(other)
+    assert contract.cache_namespace(config, cache) == expected
+
+
+@pytest.mark.parametrize("field", ["model_digest", "scales_digest", "dtype", "block_size", "head_size"])
+def test_namespace_isolates_content_and_logical_layout(tmp_path, field):
+    config, cache, manifest, path = configuration(tmp_path)
+    original = contract.cache_namespace(config, cache)
+    if field.endswith("digest"):
+        manifest[field] = "c" * 64
+        identity = {key: value for key, value in manifest.items()
+                    if key not in ("identity_digest", "patch_sources_sha256")}
+        manifest["identity_digest"] = contract.canonical_digest(identity)
+        path.write_text(json.dumps(manifest))
+    else:
+        value = torch.bfloat16 if field == "dtype" else getattr(cache.kv_cache_groups[0].kv_cache_spec, field) * 2
+        cache.kv_cache_groups[0].kv_cache_spec = replace(cache.kv_cache_groups[0].kv_cache_spec, **{field: value})
+    assert contract.cache_namespace(config, cache) != original
+
+
+def test_bounded_keys_and_direct_database_agree():
+    metadata = KeyMetadata("arbitrary/local/path", 0, 0, 0, cache_namespace="a" * 64)
+    database = ChunkedTokenDatabase([metadata], [32], None, hash_block_size=32)
+    direct = next(iter(database.process_token_key_strings(32, ["tokens"])))[2]
+    assert direct == PoolKey(metadata, "tokens").to_string()
+    assert len(direct) == 136
+    for field, value in (("head_or_tp_rank", 1), ("kv_cache_group_id", 1),
+                         ("cache_role", "state"), ("cache_family", "c128")):
+        assert PoolKey(replace(metadata, **{field: value}), "tokens").to_string() != direct
+    assert PoolKey(replace(metadata, model_name="another/path"), "tokens").to_string() == direct
+    assert not PoolKey(replace(metadata, cache_namespace=None), "tokens").to_string().startswith("asc8v1:")
+
+
+def test_strided_components_span_only_real_backing_and_preserve_guards():
+    backing = torch.full((5 * 2048,), 71, dtype=torch.uint8)
+    view = backing[512:].as_strided((5, 32, 16), (2048, 16, 1))
+    assert contract.describe_block_view(view, 5) == (512, 2048, 8704, 1)
+    view[4].fill_(19)
+    expected = torch.full_like(backing, 71)
+    expected[4 * 2048 + 512:4 * 2048 + 1024] = 19
+    assert torch.equal(backing, expected)
+    with pytest.raises(ValueError, match="contiguous"):
+        contract.describe_block_view(view.transpose(1, 2), 5)
+    with pytest.raises(ValueError, match="block count"):
+        contract.describe_block_view(view, 3)
+
+
+@pytest.mark.parametrize("setting,value", [("load_async", True), ("use_layerwise", True),
+                                           ("backend", "mooncake")])
+def test_unsupported_transfer_rejected(tmp_path, setting, value):
+    config, cache, _, _ = configuration(tmp_path)
+    config.kv_transfer_config.kv_connector_extra_config[setting] = value
+    with pytest.raises(ValueError):
+        contract.cache_namespace(config, cache)
+
+
+@pytest.mark.parametrize("result", [None, [], [0, 0], [-1], [False]])
+def test_malformed_or_partial_get_never_completes_successfully(result):
+    worker = KVPoolWorker.__new__(KVPoolWorker)
+    worker.m_store = MagicMock()
+    worker.m_store.batch_get_key_info.return_value = [NS(size=lambda: 12, gva_list=lambda: [1234])]
+    worker.m_store.get.return_value = result
+    worker._completed_sync_loads, worker._failed_sync_loads = set(), set()
+    worker._record_kv_connector_operation = MagicMock()
+    with patch("vllm_ascend.distributed.kv_transfer.kv_pool.ascend_store.pool_worker.get_tp_group"), \
+         patch.object(torch.distributed, "all_reduce"):
+        worker._load_compact_request("r", ["k"], [[1000]], [[12]])
+    assert worker._completed_sync_loads == worker._failed_sync_loads == {"r"}
+
+
+def test_nonleader_failure_propagates_to_successful_rank():
+    worker = KVPoolWorker.__new__(KVPoolWorker)
+    worker.m_store = MagicMock()
+    worker.m_store.batch_get_key_info.return_value = [NS(size=lambda: 12, gva_list=lambda: [1234])]
+    worker.m_store.get.return_value = [0]
+    worker._completed_sync_loads, worker._failed_sync_loads = set(), set()
+    worker._record_kv_connector_operation = MagicMock()
+    with patch("vllm_ascend.distributed.kv_transfer.kv_pool.ascend_store.pool_worker.get_tp_group"), \
+         patch.object(torch.distributed, "all_reduce", side_effect=lambda tensor, **kw: tensor.zero_()):
+        worker._load_compact_request("r", ["k"], [[1000]], [[12]])
+    assert worker._failed_sync_loads == {"r"}
+
+
+@pytest.mark.parametrize("size", [0, 11, 13])
+def test_wrong_object_size_prevents_get(size):
+    worker = KVPoolWorker.__new__(KVPoolWorker)
+    worker.m_store = MagicMock()
+    worker.m_store.batch_get_key_info.return_value = [NS(size=lambda: size, gva_list=lambda: [1234])]
+    worker._completed_sync_loads, worker._failed_sync_loads = set(), set()
+    with patch("vllm_ascend.distributed.kv_transfer.kv_pool.ascend_store.pool_worker.get_tp_group"), \
+         patch.object(torch.distributed, "all_reduce"):
+        worker._load_compact_request("r", ["k"], [[1000]], [[12]])
+    worker.m_store.get.assert_not_called()
+    assert worker._failed_sync_loads == {"r"}
+
+
+def test_cancelled_receive_retains_pages_until_transfer_terminal():
+    from vllm_ascend.distributed.kv_transfer.kv_pool.ascend_store.pool_scheduler import KVPoolScheduler
+    scheduler = KVPoolScheduler.__new__(KVPoolScheduler)
+    scheduler._loading_req_ids = {"cancelled"}
+    scheduler._receiving_blocks = {"cancelled": [1, 2]}
+    scheduler._block_pool = MagicMock()
+    # A cancelled request can lose its normal request reference while the
+    # connector still owns these references. Only the terminal report drops them.
+    scheduler._block_pool.free_blocks.assert_not_called()
+    scheduler.update_finished_recving({"another-request"})
+    scheduler._block_pool.free_blocks.assert_not_called()
+    scheduler.update_finished_recving({"cancelled"})
+    scheduler._block_pool.free_blocks.assert_called_once()
+    assert not scheduler._receiving_blocks
+    assert not scheduler._loading_req_ids
+
+
+def test_staged_allocation_pins_actual_group_blocks():
+    from vllm_ascend.distributed.kv_transfer.kv_pool.ascend_store.pool_scheduler import KVPoolScheduler
+    from vllm_ascend.distributed.kv_transfer.kv_pool.ascend_store.metadata import LoadSpec
+    scheduler = KVPoolScheduler.__new__(KVPoolScheduler)
+    scheduler.kv_cache_group_ids = [0, 1]
+    scheduler._unfinished_requests = {}
+    scheduler.load_specs = {'r': LoadSpec(vllm_cached_tokens=0, kvpool_cached_tokens=32, can_load=False)}
+    scheduler.load_async, scheduler.requires_load_completion, scheduler.use_layerwise = False, True, False
+    scheduler._block_pool = MagicMock()
+    scheduler._block_pool.blocks = {3: 'block3', 4: 'block4'}
+    scheduler._loading_req_ids, scheduler._receiving_blocks = set(), {}
+    blocks = MagicMock()
+    blocks.get_block_ids.return_value = [[0, 3], [4, 0]]
+    scheduler.update_state_after_alloc(NS(request_id='r'), blocks, 32)
+    scheduler._block_pool.touch.assert_called_once_with(['block3', 'block4'])
+    assert scheduler._receiving_blocks == {'r': [3, 4]}
+    assert scheduler._loading_req_ids == {'r'}
+    assert scheduler.load_specs['r'].can_load
+
+
+@pytest.mark.parametrize('tamper', ['missing', 'changed'])
+def test_partial_framework_patch_rejected(tmp_path,tamper):
