+def staggered_engine(capacity=2, terminals=None, second=True):
+    """Execute the real queue method against staggered executor completions."""
+    step, original = upstream_methods()
+    core = engine(capacity=capacity)
+    scheduler = core.scheduler
+    pool = scheduler.connector.connector_scheduler
+    scheduler.requests["r1"] = request()
+    states = {"r1": "new"}
+    terminals = terminals or {}
+    observed = {"calls": [], "forwards": [], "updates": [], "events": [], "pumps": 0}
+    future_class = upstream_future()
+    futures = deque()
+    scheduler.has_requests = lambda: bool(scheduler.requests)
+
+    def schedule(_):
+        ready = tuple(key for key in scheduler.requests if states[key] == "ready")
+        receive = tuple(key for key in scheduler.requests if states[key] == "new")
+        for key in receive:
+            states[key] = "loading"
+            pool._loading_req_ids.add(key)
+        return NS(
+            total_num_scheduled_tokens=584 * len(ready),
+            receive=receive,
+            forward=ready,
+            pending_structured_output_tokens=False,
+        )
+
+    def execute(output, non_block):
+        assert non_block
+        observed["calls"].append((output.receive, output.forward))
+        if output.forward:
+            assert all(states[key] == "ready" for key in output.forward)
+            observed["forwards"].append(output.forward)
+            observed["events"].append(("forward", output.forward))
+
+        def get_response():
+            for key in output.receive:
+                if terminals.get(key) == "cancel":
+                    scheduler.requests.pop(key, None)
+                    observed["events"].append(("cancel", key))
+                observed["events"].append(("transfer_terminal", key))
+            return NS(receive=output.receive)
+
+        return future_class(futures, get_response)
+
+    def process_inputs():
+        observed["pumps"] += 1
+        # A new input arrives during the first blocking worker response. It is
+        # drained immediately afterwards, before scheduler publication.
+        if ("transfer_terminal", "r1") not in observed["events"]:
+            return
+        if second and "r2" not in states:
+            scheduler.requests["r2"] = request()
+            states["r2"] = "new"
+            observed["events"].append(("arrived", "r2"))
+
+    def update(output, result):
+        assert result.receive == output.receive
+        observed["updates"].append(output.receive)
+        errors = []
+        for key in output.receive:
+            assert ("transfer_terminal", key) in observed["events"]
+            pool._loading_req_ids.discard(key)
+            if terminals.get(key) in ("failure", "cancel"):
+                scheduler.requests.pop(key, None)
+                observed["events"].append(("release", key))
+                errors.append(key)
+            else:
+                states[key] = "ready"
+                scheduler.finished_recving_kv_req_ids.add(key)
+        return {0: tuple(errors)} if errors else {}
+
+    def sample(_, non_block):
+        assert non_block
+        future = Future()
+        future.set_result(NS(receive=()))
+        return future
+
+    scheduler.schedule = schedule
+    scheduler.update_from_output = update
+    scheduler.get_grammar_bitmask = lambda _: None
+    core.model_executor = NS(execute_model=execute, sample_tokens=sample)
+    core.is_pooling_model = False
+    core.log_error_detail = lambda _: nullcontext()
+    core.capture_iteration_details = lambda _: nullcontext()
+    core._attach_iteration_details = Mock()
+    core._should_throttle_prefills = lambda: False
+    core._process_aborts_queue = Mock()
+    core._process_input_queue = process_inputs
+    core.post_step = Mock()
+    core.output_queue = NS(put_nowait=Mock())
+    core.step_fn = lambda: step(core)
+    return core, original, observed
+
