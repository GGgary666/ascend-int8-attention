+@pytest.mark.parametrize('compact', [True, False])
+def test_delayed_put_preserves_source_until_the_next_model_step(compact):
+    import threading
+    from vllm_ascend.distributed.kv_transfer.kv_pool.ascend_store.kv_transfer import (
+        KVCacheStoreBatch, KVCacheStoreSendingThread,
+    )
+    worker=KVPoolWorker.__new__(KVPoolWorker)
+    worker.requires_load_completion=compact
+    worker.group_uses_align_state=[False]
+    sender=KVCacheStoreSendingThread.__new__(KVCacheStoreSendingThread)
+    sender.raise_if_failed=MagicMock()
+    source=bytearray(b'original')
+    copied=[];errors=[]
+    entered,release,returned=threading.Event(),threading.Event(),threading.Event()
+    batch=KVCacheStoreBatch()
+    def copy_when_released():
+        entered.set()
+        if release.wait(5):copied.append(bytes(source))
+        batch.done.set()
+    transfer=threading.Thread(target=copy_when_released)
+    def queue(requests):
+        transfer.start()
+        return batch
+    sender.add_save_batch=queue
+    worker.kv_send_thread=sender
+    def next_step():
+        try:
+            worker.wait_for_save(NS(requests=[NS(can_save=True)]))
+            # Reuse the SWA/state bytes as the next model step may do.
+            source[:]=b'nextstep'
+        except BaseException as exc:errors.append(exc)
+        finally:returned.set()
+    runner=threading.Thread(target=next_step)
+    try:
+        runner.start()
+        assert entered.wait(5)
+        if compact:assert not returned.wait(.05),'C8 returned while PUT still owns source bytes'
+        else:assert returned.wait(5),'Legacy asynchronous behavior changed'
+    finally:
+        release.set();runner.join(5);transfer.join(5)
+    assert not errors and not runner.is_alive() and not transfer.is_alive()
+    assert copied==[b'original' if compact else b'nextstep']
