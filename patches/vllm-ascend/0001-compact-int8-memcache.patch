+    node = next(
+        n for n in ast.parse(path.read_text()).body if isinstance(n, ast.ClassDef) and n.name == "FutureWrapper"
+    )
+    namespace = dict(
+        Future=Future, deque=deque, Callable=Callable, Any=Any, suppress=suppress, InvalidStateError=InvalidStateError
+    )
+    exec(compile(ast.fix_missing_locations(ast.Module(body=[node], type_ignores=[])), str(path), "exec"), namespace)
