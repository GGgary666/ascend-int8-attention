+def test_filtered_pages_and_shards_match_full_reference_walk(namespace):
+    generator = random.Random(1729)
+    for _ in range(1000):
+        block_size = generator.choice([2, 8, 32, 128])
+        current = database(namespace, block_size)
+        hashes = [index.to_bytes(4, "big") * 8 for index in range(generator.randrange(258))]
+        token_len = generator.randrange(-4, len(hashes) * 2 + 101)
+        num_blocks = min(len(hashes) // (block_size // 2), max(0, -(-token_len // block_size)))
+        mask_num = generator.randrange(-9, max(token_len, 0) + 101)
+        block_ids = (
+            None
+            if generator.randrange(2)
+            else [generator.randrange(-1, 50) for _ in range(generator.randrange(num_blocks + 4))]
+        )
+        mask = (
+            None
+            if generator.randrange(3) == 0
+            else [bool(generator.randrange(2)) for _ in range(generator.randrange(num_blocks + 4))]
+        )
+        skip_null = bool(generator.randrange(2))
+        shard_rank = generator.choice([None, 0, 1, 3])
+        shard_size = generator.choice([None, 1, 2, 4])
+        offset = max(num_blocks - len(block_ids), 0) if block_ids is not None else 0
+        expected = []
+        for chunk in range(num_blocks):
+            start, end = chunk * block_size, min((chunk + 1) * block_size, token_len)
+            if start < mask_num or end <= start or chunk % 3 == 1:
+                continue
+            if mask is not None and (chunk >= len(mask) or not mask[chunk]):
+                continue
+            block_id = None
+            if block_ids is not None:
+                if not 0 <= chunk - offset < len(block_ids):
+                    continue
+                block_id = block_ids[chunk - offset]
+                if skip_null and block_id <= 0:
+                    continue
+            expected.append((start, end, hashes[(chunk + 1) * (block_size // 2) - 1], block_id))
+        if shard_rank is not None and shard_size is not None and shard_size > 1:
+            expected = [entry for index, entry in enumerate(expected) if index % shard_size == shard_rank]
+
+        def allowed(start, block_size=block_size, mask=mask):
+            chunk = start // block_size
+            return chunk % 3 != 1 and (mask is None or (chunk < len(mask) and mask[chunk]))
